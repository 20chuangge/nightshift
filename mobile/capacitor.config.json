{
  "appId": "com.desk.assistant",
  "appName": "Lamplit",
  "webDir": "www",
  "backgroundColor": "#0a0a0a",
  "server": {
    "hostname": "localhost",
    "androidScheme": "http",
    "iosScheme": "capacitor",
    "cleartext": true,
    "allowNavigation": ["*"]
  },
  "android": {
    "backgroundColor": "#0a0a0a",
    "zoomEnabled": false
  },
  "ios": {
    "backgroundColor": "#0a0a0a",
    "preferredContentMode": "mobile",
    "zoomEnabled": false,
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": false,
      "style": "dark"
    }
  }
}
